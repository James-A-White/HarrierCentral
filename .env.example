# =============================================================================
# Harrier Central — environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
# =============================================================================

# ── SQL Server (Azure SQL) ────────────────────────────────────────────────────
HC_SQL_SERVER=yourserver.database.windows.net
HC_SQL_DATABASE=HarrierCentral
HC_SQL_USERNAME=yourusername
HC_SQL_PASSWORD=yourpassword

# ── Contract extraction (tools/extract_contracts.js) ─────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# tools/log_triage_daily.sh — iMessage recipient (phone number or Apple ID) for the daily log triage
HC_TRIAGE_IMESSAGE_TO=

# Beta Testers room assistant (E18.F9) — a DEVICE under James's account,
# minted once with `python3 tools/beta_room.py register --user-id <James's id>`.
# The tool reads the room and posts tagged replies through the app API; it
# never touches the database. Keep these out of git; Key Vault is E18.F3.S6.
HC_AGENT_USER_ID=
HC_AGENT_DEVICE_ID=
HC_AGENT_DEVICE_SECRET=
HC_AGENT_TIME_WINDOW=
