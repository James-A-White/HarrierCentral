        { "name": "receiptId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Receipt.id." },
        { "name": "eventId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Receipt.EventId." },
