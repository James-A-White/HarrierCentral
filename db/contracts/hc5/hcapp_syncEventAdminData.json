  ],
  "sideEffects": [],
  "codeSmells": [
    {
      "severity": "high",
      "issue": "@kennelCreditsUpdatedAfter is a dead parameter",
      "detail": "Accepted in the signature but the entire KennelCredits block is commented out. Remove in HC6."
    },
    {
      "severity": "medium",
      "issue": "Watermark cursors are strings cast to datetimeoffset — brittle",
      "detail": "All cursor parameters are NVARCHAR(50) and cast to datetimeoffset without TRY_CAST. Invalid strings will throw an unhandled exception."
    },
    {
      "severity": "medium",
      "issue": "updatedAt serialised as local datetime2 string — no timezone",
      "detail": "CONVERT(nvarchar(50), cast(updatedAt as datetime2)) strips timezone. Used as the next sync cursor, causing drift when server or client timezone differs from UTC."
    },
    {
      "severity": "medium",
      "issue": "HKM isMember is computed on the fly — not the stored IsMember column",
      "detail": "CASE WHEN coalesce(MembershipExpirationDate,'1/1/2000') > getdate() THEN 1 ELSE 0 END. The stored HKM.IsMember column is not used here — which means it can diverge."
    }
  ],
  "breakingChangeRules": [
    "Never remove a column from any rowset",
    "Never rename a parameter",
    "Never change a parameter type",
    "Never change the 'ignore' sentinel without updating all callers"
  ]
}
