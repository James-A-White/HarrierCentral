{
  "schema": "HC5",
  "name": "hcapp_syncEventAdminData",
  "version": "1.0.0",
  "description": "Incremental pull-sync SP for event admin data. Returns up to 6 result sets — each is only emitted when its corresponding 'updatedAfter' cursor parameter is not 'ignore'. Callers track the max updatedAt from each result set as the next cursor. Used as a delegate by write SPs (addEditEvent, processPayment, joinEventAsVisitor, etc.) that need to return fresh data after writing. @procName and @param override the SP name and device secret in token validation — allowing delegating SPs to pass their own token context.",
  "parameters": [
    { "name": "deviceId", "type": "UNIQUEIDENTIFIER", "nullable": false, "mapsToColumn": "Device.id", "description": "Device UUID." },
    { "name": "accessToken", "type": "NVARCHAR(1000)", "nullable": false, "mapsToColumn": null, "description": "Token validated against coalesce(@param, @deviceSecret) and coalesce(@procName, OBJECT_NAME(@@PROCID))." },
    { "name": "eventId", "type": "UNIQUEIDENTIFIER", "nullable": false, "mapsToColumn": null, "description": "Event to scope the sync to. Required." },
    { "name": "hashersUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Hashers. 'ignore' = skip this result set. Default 'ignore'." },
    { "name": "hasherEventMapUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for HasherEventMap (scoped to @eventId). 'ignore' = skip." },
    { "name": "hasherKennelMapUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for HasherKennelMap (scoped to event's kennel). 'ignore' = skip." },
    { "name": "narrowEventsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for the specific event record. 'ignore' = skip." },
    { "name": "paymentsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Payments (scoped to @eventId). 'ignore' = skip." },
    { "name": "receiptsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Receipts (scoped to @eventId). 'ignore' = skip." },
    { "name": "kennelCreditsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Accepted but fully commented out — dead parameter. KennelCredits sync is disabled." },
    { "name": "usePaging", "type": "INT", "nullable": true, "mapsToColumn": null, "description": "Default 0. When non-zero, applies page limits (1000 hashers, 250 others). When 0, limits are set to 1,000,000 (effectively unlimited)." },
    { "name": "procName", "type": "NVARCHAR(100)", "nullable": true, "mapsToColumn": null, "description": "Override for the SP name in token validation. Delegating SPs pass their own name to match the token the client generated." },
    { "name": "param", "type": "NVARCHAR(500)", "nullable": true, "mapsToColumn": null, "description": "Override for the device secret in token validation. Delegating SPs pass their compound token string." }
  ],
  "rowsets": [
    {
      "index": 0,
      "name": "NullUserError",
      "description": "Standard error format. errorType=2."
    },
    {
      "index": 0,
      "name": "NullEventError",
      "description": "Standard error format. errorType=2."
    },
    {
      "index": 0,
      "name": "AuthError",
      "description": "Standard error format. errorType=3."
    },
    {
      "index": "conditional",
      "name": "Hashers",
      "description": "Emitted only when @hashersUpdatedAfter != 'ignore'. All Hashers updated after the watermark (not event-scoped — global). Page size: 1000.",
      "columns": [
        { "name": "hasherId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Hasher.id." },
        { "name": "firstName", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "lastName", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "dispName", "type": "NVARCHAR", "nullable": false, "description": "DisplayName coalesced to ''." },
        { "name": "hashName", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "photo", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "dispPref", "type": "SMALLINT", "nullable": false, "description": "NameDisplayPreference." },
        { "name": "includeInGlobalHashDirectory", "type": "SMALLINT", "nullable": false, "description": "Coalesced to 0." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "CONVERT(nvarchar(50), datetime2) — local time, no timezone." },
        { "name": "removed", "type": "SMALLINT", "nullable": false, "description": "Coalesced to 0." }
      ]
    },
    {
      "index": "conditional",
      "name": "HasherEventMap",
      "description": "Emitted only when @hasherEventMapUpdatedAfter != 'ignore'. HEM records for @eventId updated after watermark. Includes joined Event and HKM fields. Page size: 250.",
      "columns": [
        { "name": "hemId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "HasherEventMap.id." },
