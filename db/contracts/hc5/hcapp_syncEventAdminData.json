        { "name": "eventId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "HasherEventMap.EventId." },
        { "name": "hasherOwnEventId", "type": "UNIQUEIDENTIFIER", "nullable": true, "description": "HasherEventMap.HasherOwnEventId." },
        { "name": "userStartEvent", "type": "DATETIMEOFFSET", "nullable": true, "description": "When user checked in." },
        { "name": "userEndEvent", "type": "DATETIMEOFFSET", "nullable": true, "description": "When user checked out." },
        { "name": "rsvpState", "type": "INT", "nullable": true, "description": "HasherEventMap.RsvpState." },
        { "name": "attendenceState", "type": "INT", "nullable": true, "description": "HasherEventMap.AttendenceState." },
        { "name": "isHare", "type": "SMALLINT", "nullable": true, "description": "HasherEventMap.IsHare." },
        { "name": "eventNotificationPreference", "type": "INT", "nullable": true, "description": "HasherEventMap.EventNotificationPreference." },
        { "name": "eventEmailAlertPreference", "type": "INT", "nullable": true, "description": "HasherEventMap.EventEmailAlertPreference." },
        { "name": "eventCountOverride", "type": "INT", "nullable": true, "description": "HasherEventMap.EventCountOverride." },
        { "name": "virginVisitorType", "type": "SMALLINT", "nullable": true, "description": "HasherEventMap.VirginVisitorType." },
        { "name": "totalHaring", "type": "INT", "nullable": true, "description": "HasherEventMap.TotalHaring." },
        { "name": "totalHaringThisKennel", "type": "INT", "nullable": true, "description": "HasherEventMap.TotalHaringThisKennel." },
        { "name": "totalRuns", "type": "INT", "nullable": true, "description": "HasherEventMap.TotalRuns." },
        { "name": "totalRunsThisKennel", "type": "INT", "nullable": true, "description": "HasherEventMap.TotalRunsThisKennel." },
        { "name": "displayName", "type": "NVARCHAR", "nullable": true, "description": "HasherEventMap.DisplayName (for visitors)." },
        { "name": "email", "type": "NVARCHAR", "nullable": true, "description": "HasherEventMap.Email." },
        { "name": "phoneNumber", "type": "NVARCHAR", "nullable": true, "description": "HasherEventMap.PhoneNumber." },
        { "name": "hemEventNumber", "type": "INT", "nullable": true, "description": "Event.EventNumber." },
        { "name": "hemEventName", "type": "NVARCHAR", "nullable": true, "description": "FB/non-FB event name." },
        { "name": "hemEventStartDatetime", "type": "DATETIME2", "nullable": true, "description": "Event start — local time, no timezone (hack noted in SP comment)." },
        { "name": "hemEventStartDatetimeGmt", "type": "DATETIMEOFFSET", "nullable": true, "description": "Event start in UTC from EventStartDatetimeGmt." },
        { "name": "hemCanEditRunAttendence", "type": "SMALLINT", "nullable": true, "description": "Event.CanEditRunAttendence." },
        { "name": "hemEventIsCountedAndVisible", "type": "INT", "nullable": false, "description": "1 when IsCountedRun!=0 AND IsVisible!=0." },
        { "name": "hemEventKennelId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Event.KennelId." },
        { "name": "hemKennelUserPhoto", "type": "NVARCHAR", "nullable": true, "description": "HasherKennelMap.KennelUserPhoto." },
        { "name": "hemKennelHashName", "type": "NVARCHAR", "nullable": true, "description": "HasherKennelMap.KennelHashName." },
        { "name": "removed", "type": "SMALLINT", "nullable": false, "description": "HasherEventMap.removed." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." }
      ]
    },
    {
      "index": "conditional",
      "name": "HasherKennelMap",
      "description": "Emitted only when @hasherKennelMapUpdatedAfter != 'ignore'. HKM records for event's kennel updated after watermark. Note: isMember is computed (ExpirationDate > today), not stored. Page size: 250.",
      "columns": [
        { "name": "hkmId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "HasherKennelMap.id." },
        { "name": "userId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "HasherKennelMap.UserId." },
        { "name": "kennelId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "HasherKennelMap.KennelId." },
        { "name": "following", "type": "SMALLINT", "nullable": true, "description": "HasherKennelMap.Following." },
        { "name": "isMember", "type": "INT", "nullable": false, "description": "1 if MembershipExpirationDate > today, else 0. Computed — not stored column." },
        { "name": "isHomeKennel", "type": "SMALLINT", "nullable": true, "description": "HasherKennelMap.IsHomeKennel." },
        { "name": "isKennelFollowing", "type": "SMALLINT", "nullable": true, "description": "HasherKennelMap.IsKennelFollowing." },
        { "name": "kennelNotificationPreference", "type": "SMALLINT", "nullable": true, "description": "HasherKennelMap.KennelNotificationPreference." },
        { "name": "kennelEmailAlertPreference", "type": "SMALLINT", "nullable": true, "description": "HasherKennelMap.KennelEmailAlertPreference." },
        { "name": "mismanagementRoles", "type": "INT", "nullable": true, "description": "HasherKennelMap.MismanagementRoles." },
        { "name": "userRoleFlags", "type": "INT", "nullable": true, "description": "HasherKennelMap.UserRoleFlags." },
        { "name": "appAccessFlags", "type": "INT", "nullable": true, "description": "HasherKennelMap.AppAccessFlags." },
        { "name": "hcTotalRunCount", "type": "INT", "nullable": true, "description": "HasherKennelMap.HcTotalRunCount." },
        { "name": "hcHaringCount", "type": "INT", "nullable": true, "description": "HasherKennelMap.HcHaringCount." },
        { "name": "historicalHaringCount", "type": "INT", "nullable": true, "description": "HasherKennelMap.HistoricalHaringCount." },
        { "name": "historicalTotalRunCount", "type": "INT", "nullable": true, "description": "HasherKennelMap.HistoricalTotalRunCount." },
        { "name": "historicalCountIsEstimate", "type": "INT", "nullable": true, "description": "HasherKennelMap.HistoricalCountIsEstimate." },
        { "name": "kennelCredit", "type": "DECIMAL", "nullable": true, "description": "HasherKennelMap.KennelCredit." },
        { "name": "discountAmount", "type": "SMALLMONEY", "nullable": true, "description": "HasherKennelMap.DiscountAmount." },
        { "name": "discountPercent", "type": "SMALLINT", "nullable": true, "description": "HasherKennelMap.DiscountPercent." },
        { "name": "discountDescription", "type": "NVARCHAR", "nullable": true, "description": "HasherKennelMap.DiscountDescription." },
        { "name": "membershipExpirationDate", "type": "DATETIMEOFFSET", "nullable": true, "description": "HasherKennelMap.MembershipExpirationDate." },
        { "name": "authorizedDeviceList", "type": "NVARCHAR", "nullable": false, "description": "Always empty string ''." },
        { "name": "authorizedDeviceCount", "type": "INT", "nullable": false, "description": "Always 0." },
        { "name": "memberSince", "type": "DATETIMEOFFSET", "nullable": true, "description": "HasherKennelMap.MemberSince." },
        { "name": "dateOfLastRun", "type": "DATETIMEOFFSET", "nullable": true, "description": "HasherKennelMap.DateOfLastRun." },
        { "name": "kennelUserPhoto", "type": "NVARCHAR", "nullable": true, "description": "HasherKennelMap.KennelUserPhoto." },
        { "name": "kennelHashName", "type": "NVARCHAR", "nullable": true, "description": "HasherKennelMap.KennelHashName." },
        { "name": "removed", "type": "SMALLINT", "nullable": false, "description": "HasherKennelMap.removed." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." }
      ]
    },
    {
      "index": "conditional",
      "name": "Event",
      "description": "Emitted only when @narrowEventsUpdatedAfter != 'ignore'. Single event row (filtered by @eventId) if updated after watermark. Includes FB/non-FB field resolution, geolocation merging with kennel fallback. Page size: N/A (WHERE id = @eventId, at most 1 row).",
      "columns": [
        { "name": "eventId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Event.id." },
        { "name": "publicEventId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Event.PublicEventId." },
        { "name": "kennelId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Event.KennelId." },
        { "name": "(many event fields)", "type": "various", "nullable": true, "description": "See syncUserData NarrowEvents rowset for the full event column list — same structure." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." }
      ]
    },
