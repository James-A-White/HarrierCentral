  "sideEffects": [],
  "codeSmells": [
    {
      "severity": "high",
      "issue": "updatedAt serialised as local datetime2 string — no timezone",
      "detail": "CONVERT(nvarchar(50), cast(updatedAt as datetime2)) strips timezone info. Sync cursors from different timezones will drift. Should use datetimeoffset formatted string."
    },
    {
      "severity": "high",
      "issue": "eventDescription uses Event.SyncDescription not Event.EventDescription",
      "detail": "The NarrowEvents result set returns evt.SyncDescription as 'eventDescription'. This differs from syncEventAdminData which derives it from FB/non-FB EventDescription. The two sync SPs return different descriptions for the same event."
    },
    {
      "severity": "medium",
      "issue": "Kennel.DefaultRunStartTime converted via DATETIME + DATETIME hack",
      "detail": "CONVERT(DATETIME, '1900-01-01') + CONVERT(DATETIME, DefaultRunStartTime) is used to combine a sentinel date with the time value. Unconventional and potentially fragile on certain time values."
    },
    {
      "severity": "medium",
      "issue": "syncUserData Hashers includes homeKennelId but syncEventAdminData does not",
      "detail": "The two Hasher rowsets are almost identical but differ in this one column. Callers that use both sync SPs receive different Hasher schemas — potential for model divergence."
    },
    {
      "severity": "medium",
      "issue": "Watermark cursors are strings cast to datetimeoffset — no TRY_CAST",
      "detail": "Invalid cursor strings will throw unhandled exceptions."
    },
    {
      "severity": "low",
      "issue": "@initialLoad parameter accepted but never used",
      "detail": "Likely intended for a future initial-load optimisation."
    }
  ],
  "breakingChangeRules": [
    "Never remove a column from any rowset",
    "Never rename a parameter",
    "Never change a parameter type",
    "Never change the 'ignore' sentinel without updating all callers",
    "Never add/remove result sets without coordinating with the Flutter app sync engine"
  ]
}
