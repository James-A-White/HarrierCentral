        { "name": "cityId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "City.id." },
        { "name": "cityName", "type": "NVARCHAR", "nullable": true, "description": "City.CityName." },
        { "name": "citySearchTags", "type": "NVARCHAR", "nullable": true, "description": "City.CitySearchTags." },
        { "name": "regionId", "type": "UNIQUEIDENTIFIER", "nullable": true, "description": "City.RegionId." },
        { "name": "latitude", "type": "DECIMAL", "nullable": true, "description": "City.Latitude." },
        { "name": "longitude", "type": "DECIMAL", "nullable": true, "description": "City.Longitude." },
        { "name": "cityAscii", "type": "NVARCHAR", "nullable": true, "description": "City.City_ASCII." },
        { "name": "flagFile", "type": "NVARCHAR", "nullable": true, "description": "City.FlagFile." },
        { "name": "removed", "type": "SMALLINT", "nullable": true, "description": "City.Removed." },
        { "name": "ianaTimeZone", "type": "NVARCHAR", "nullable": false, "description": "DomainValues.Timezone.IanaTimeZone. Defaults to 'Europe/London' if NULL." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." }
      ]
    },
    {
      "index": "conditional",
      "name": "Regions",
      "description": "Regions updated after watermark — only those with at least one Kennel. Page size: 250.",
      "columns": [
        { "name": "regionId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Region.id." },
        { "name": "regionName", "type": "NVARCHAR", "nullable": true, "description": "Region.RegionName." },
        { "name": "regionAbbreviation", "type": "NVARCHAR", "nullable": true, "description": "Region.RegionAbbreviation." },
        { "name": "countryId", "type": "UNIQUEIDENTIFIER", "nullable": true, "description": "Region.CountryId." },
        { "name": "flagFile", "type": "NVARCHAR", "nullable": true, "description": "Region.FlagFile." },
        { "name": "regionSearchTags", "type": "NVARCHAR", "nullable": true, "description": "Region.RegionSearchTags." },
        { "name": "removed", "type": "SMALLINT", "nullable": true, "description": "Region.Removed." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." }
      ]
    },
    {
      "index": "conditional",
      "name": "Countries",
      "description": "Countries updated after watermark. Page size: 250.",
      "columns": [
        { "name": "countryId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Country.id." },
        { "name": "countryCode", "type": "NVARCHAR", "nullable": true, "description": "Country.CountryCode." },
        { "name": "latitude", "type": "DECIMAL", "nullable": true, "description": "Country.Latitude." },
        { "name": "longitude", "type": "DECIMAL", "nullable": true, "description": "Country.Longitude." },
        { "name": "countryName", "type": "NVARCHAR", "nullable": true, "description": "Country.CountryName." },
        { "name": "continentCode", "type": "NVARCHAR", "nullable": true, "description": "Country.ContinentCode." },
        { "name": "flagFile", "type": "NVARCHAR", "nullable": true, "description": "Country.FlagFile." },
        { "name": "currencyCode", "type": "NVARCHAR", "nullable": true, "description": "Country.CurrencyCode." },
        { "name": "primaryCultureCode", "type": "NVARCHAR", "nullable": true, "description": "Country.PrimaryCultureCode." },
        { "name": "showRegion", "type": "SMALLINT", "nullable": true, "description": "Country.ShowRegion." },
        { "name": "currencySymbol", "type": "NVARCHAR", "nullable": true, "description": "Country.CurrencySymbol." },
        { "name": "digitsAfterDecimal", "type": "INT", "nullable": true, "description": "Country.DigitsAfterDecimal." },
        { "name": "distancePreference", "type": "SMALLINT", "nullable": true, "description": "Country.DistancePreference." },
        { "name": "countrySearchTags", "type": "NVARCHAR", "nullable": true, "description": "Country.CountrySearchTags." },
        { "name": "removed", "type": "SMALLINT", "nullable": true, "description": "Country.Removed." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." }
      ]
    },
    {
      "index": "conditional",
      "name": "Songs",
      "description": "Songs updated after watermark. All songs globally (no user scope). Page size: 250.",
      "columns": [
        { "name": "songId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Song.id." },
        { "name": "songName", "type": "NVARCHAR", "nullable": true, "description": "Song.SongName." },
        { "name": "tuneOf", "type": "NVARCHAR", "nullable": true, "description": "Song.TuneOf." },
        { "name": "bawdyRating", "type": "INT", "nullable": true, "description": "Song.BawdyRating." },
        { "name": "notes", "type": "NVARCHAR", "nullable": true, "description": "Song.Notes." },
        { "name": "actions", "type": "NVARCHAR", "nullable": true, "description": "Song.Actions." },
        { "name": "variants", "type": "NVARCHAR", "nullable": true, "description": "Song.Variants." },
