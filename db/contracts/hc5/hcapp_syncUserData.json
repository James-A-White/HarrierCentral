        { "name": "audioUrl", "type": "NVARCHAR", "nullable": true, "description": "Song.AudioUrl." },
        { "name": "autoAddToKennel", "type": "SMALLINT", "nullable": true, "description": "Song.AutoAddToKennel." },
        { "name": "rank", "type": "INT", "nullable": true, "description": "Song.Rank." },
        { "name": "addedByKennelId", "type": "UNIQUEIDENTIFIER", "nullable": true, "description": "Song.AddedBy_KennelId." },
        { "name": "addedByUserId", "type": "UNIQUEIDENTIFIER", "nullable": true, "description": "Song.AddedBy_UserId." },
        { "name": "lyrics", "type": "NVARCHAR", "nullable": true, "description": "Song.Lyrics." },
        { "name": "tags", "type": "NVARCHAR", "nullable": true, "description": "Song.Tags." },
        { "name": "removed", "type": "SMALLINT", "nullable": false, "description": "Song.Removed." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." }
      ]
    },
    {
      "index": "conditional",
      "name": "Kennels",
      "description": "All Kennels updated after watermark. Full kennel profile including banking info and three payment schemes. DefaultRunStartTime converted via CONVERT(DATETIME, '1900-01-01') + CONVERT(DATETIME, time) hack. OPTION (RECOMPILE) hint. Page size: 250.",
      "columns": [
        { "name": "(same structure as syncKennelAdminData Kennels)", "type": "various", "nullable": true, "description": "Includes all kennel fields. See syncKennelAdminData.Kennels for full column list." },
        { "name": "disseminateAllowWebLinks", "type": "SMALLINT", "nullable": true, "description": "Kennel.DisseminateAllowWebLinks. Present in syncUserData Kennels, not in syncKennelAdminData." }
      ]
    },
    {
      "index": "conditional",
      "name": "HasherKennelMap",
      "description": "User-scoped HKM records updated after watermark. Uses stored IsMember column. Page size: 250.",
      "columns": [
        { "name": "(same as syncKennelAdminData HasherKennelMap)", "type": "various", "nullable": true, "description": "See syncKennelAdminData.HasherKennelMap for column details." }
      ]
    },
    {
      "index": "conditional",
      "name": "HasherEventMap",
      "description": "User-scoped HEM records updated after watermark. Includes hemCountryId (not in syncEventAdminData). Page size: 250.",
      "columns": [
        { "name": "(similar to syncEventAdminData HasherEventMap + hemCountryId)", "type": "various", "nullable": true, "description": "See syncEventAdminData.HasherEventMap. Additional column: hemCountryId (Event.CountryId)." }
      ]
    },
