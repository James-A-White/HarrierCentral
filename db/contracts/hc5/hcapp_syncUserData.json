{
  "schema": "HC5",
  "name": "hcapp_syncUserData",
  "version": "1.0.0",
  "description": "The primary incremental pull-sync SP for the app. Returns up to 11 optional result sets based on 'updatedAfter' cursor parameters. All data is scoped to the calling user where applicable. The event result set (narrowEventsUpdatedAfter) filters to events that are either recent (10 days), at followed kennels, or attended by the user. @forceReplicateAllRunsForKennel is an alternative to narrowEventsUpdatedAfter that dumps all events for a specific kennel. This SP was refactored for performance (removed LOWER() calls, added EXISTS filters, OPTION RECOMPILE hints).",
  "parameters": [
    { "name": "deviceId", "type": "UNIQUEIDENTIFIER", "nullable": false, "mapsToColumn": "Device.id", "description": "Device UUID." },
    { "name": "accessToken", "type": "NVARCHAR(1000)", "nullable": false, "mapsToColumn": null, "description": "Token validated against coalesce(@param, @deviceSecret)." },
    { "name": "hashersUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Hashers (all, not user-scoped). 'ignore' = skip. Default 'ignore'." },
    { "name": "citiesUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Cities (only cities with kennels). 'ignore' = skip." },
    { "name": "regionsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Regions (only regions with kennels). 'ignore' = skip." },
    { "name": "countriesUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Countries. 'ignore' = skip." },
    { "name": "kennelsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Kennels (all). 'ignore' = skip." },
    { "name": "hasherKennelMapUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for HasherKennelMap (user-scoped). 'ignore' = skip." },
    { "name": "hasherEventMapUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for HasherEventMap (user-scoped). 'ignore' = skip." },
    { "name": "narrowEventsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Events (recent, followed, or attended). 'ignore' = skip. Mutually exclusive with @forceReplicateAllRunsForKennel." },
    { "name": "paymentsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Payments (user-scoped). 'ignore' = skip." },
    { "name": "songsUpdatedAfter", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "Watermark for Songs (all songs globally). 'ignore' = skip." },
    { "name": "forceReplicateAllRunsForKennel", "type": "NVARCHAR(50)", "nullable": true, "mapsToColumn": null, "description": "UUID as string. When not 'ignore', disables narrowEventsUpdatedAfter and returns all events for the specified kennel (within the same recent/followed/attended filter). Default 'ignore'." },
    { "name": "usePaging", "type": "INT", "nullable": true, "mapsToColumn": null, "description": "Default 0 (unlimited). Non-zero applies page limits: 1000 for hashers, 250 for others, 50 for events." },
    { "name": "initialLoad", "type": "INT", "nullable": true, "mapsToColumn": null, "description": "Accepted but not currently used in the SP logic. Intended for future initial-load optimisation." },
    { "name": "procName", "type": "NVARCHAR(100)", "nullable": true, "mapsToColumn": null, "description": "Override SP name for token validation." },
    { "name": "param", "type": "NVARCHAR(500)", "nullable": true, "mapsToColumn": null, "description": "Override device secret for token validation." }
  ],
  "rowsets": [
    {
      "index": 0,
      "name": "NullUserError",
      "description": "Standard error format. errorType=2."
    },
    {
      "index": 0,
      "name": "AuthError",
      "description": "Standard error format. errorType=3."
    },
    {
      "index": "conditional",
      "name": "Hashers",
      "description": "All Hashers updated after watermark. Not user-scoped — returns everyone. Page size: 1000. Note: homeKennelId added (not in syncEventAdminData Hashers).",
      "columns": [
        { "name": "hasherId", "type": "UNIQUEIDENTIFIER", "nullable": false, "description": "Hasher.id." },
        { "name": "homeKennelId", "type": "UNIQUEIDENTIFIER", "nullable": true, "description": "Hasher.HomeKennelId. Present in this SP only, not in syncEventAdminData." },
        { "name": "firstName", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "lastName", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "dispName", "type": "NVARCHAR", "nullable": false, "description": "DisplayName coalesced to ''." },
        { "name": "hashName", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "photo", "type": "NVARCHAR", "nullable": false, "description": "Coalesced to ''." },
        { "name": "dispPref", "type": "SMALLINT", "nullable": false, "description": "NameDisplayPreference." },
        { "name": "includeInGlobalHashDirectory", "type": "SMALLINT", "nullable": false, "description": "Coalesced to 0." },
        { "name": "updatedAt", "type": "NVARCHAR(50)", "nullable": false, "description": "Local datetime2 string." },
        { "name": "removed", "type": "SMALLINT", "nullable": false, "description": "Coalesced to 0." }
      ]
    },
    {
      "index": "conditional",
      "name": "Cities",
      "description": "Cities updated after watermark — only cities that have at least one Kennel (EXISTS filter). Includes ianaTimeZone from DomainValues.Timezone join. Page size: 250.",
