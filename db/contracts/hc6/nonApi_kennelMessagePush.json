{
  "schema": "HC6",
  "name": "nonApi_kennelMessagePush",
  "version": "1.0.0",
  "description": "The push for a kennel-thread message not posted by a client (the weekly Mismanagement reminder, E9.F1.S33), in hcapp_sendKennelMessage's three-rowset shape so the API's kennel-chat push code (SendChatNotifications, ChatPushKind.Kennel) sends it unchanged. Audience = HC6.KennelChatPushAudience, the same function the send uses. The API timer calls it once per NEW reminder (AlreadyPosted = 0); calling it again would push again. Not reachable from a client.",
  "parameters": [
    {
      "name": "messageId",
      "type": "UNIQUEIDENTIFIER",
      "nullable": true,
      "mapsToColumn": null,
      "description": "A kennel-thread message (KennelId set, EventId NULL, not removed). Anything else: all three rowsets empty."
    }
  ],
