  "sideEffects": [
    "INSERT HC.ErrorLog from the CATCH block (lines 52-54, after ROLLBACK)"
  ],
  "codeSmells": [
    {
      "severity": "low",
      "issue": "Unknown run is silent",
      "detail": "Lines 43-48 return no row for a NULL or unknown @eventId and log nothing, so the app cannot tell 'no such run' from 'not visible'."
    },
    {
      "severity": "low",
      "issue": "SELECT f.* couples the rowset to the function",
      "detail": "Line 43 returns every column of HC6.EventsForPhone(), so a column added to the function for the sync appears here too; that is the intent (one shape), but a column reordered there reorders this rowset, and the only ordering the app relies on is eventId first."
    }
  ],
  "breakingChangeRules": [
    "Never remove a column from any rowset",
    "Never rename a parameter",
    "Never change a parameter type",
    "Never change a sentinel value meaning",
    "Never change errorType integer codes without updating all callers"
  ]
