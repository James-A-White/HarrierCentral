{
  "schema": "HC6",
  "name": "hcapp_getRunForPhone",
  "version": "1.0.0",
  "description": "ONE run in the phone's events-table shape (HC6.EventsForPhone — the same columns as the user sync's events rowset), so the app can store and open a run that is not on the phone without following its kennel (James, 2026-10-04: 'is there a way to load just that one run?'). The user sync carries only ten days of the runs of kennels a hasher does not follow; the kennel trail map shows them all. Only visible, non-deleted runs — the same runs the public web shows. The first column is eventId, which the app's sync writer recognises. Auth: HC6.ValidateAppAuth (spNumber 150, @param NULL); no permission gate.",
  "parameters": [
    {
      "name": "deviceId",
      "type": "UNIQUEIDENTIFIER",
      "nullable": true,
      "mapsToColumn": null,
      "description": "Registered device. Default NULL (auth failure)."
    },
    {
      "name": "accessToken",
      "type": "NVARCHAR(1000)",
      "nullable": true,
      "mapsToColumn": null,
      "description": "Short-lived token (standard, device secret). Default NULL."
    },
    {
      "name": "eventId",
      "type": "UNIQUEIDENTIFIER",
      "nullable": true,
      "mapsToColumn": "Event.id",
      "description": "The run. NULL, unknown, deleted or not visible is not an error: the rowset is empty."
    }
  ],
  "rowsets": [
    {
