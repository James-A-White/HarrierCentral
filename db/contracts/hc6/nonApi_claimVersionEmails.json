    {
      "name": "sendId",
      "type": "UNIQUEIDENTIFIER",
      "nullable": true,
      "mapsToColumn": "EmailLog.SendId",
      "description": "The send."
    },
    {
      "name": "take",
      "type": "INT",
      "nullable": true,
      "mapsToColumn": null,
      "description": "1..50, default 10."
    }
  ],
  "rowsets": [
    {
      "index": 0,
      "name": "Claimed",
      "description": "What each email needs.",
      "columns": [
        {
          "name": "EmailLogId",
          "type": "UNIQUEIDENTIFIER",
          "nullable": false,
          "description": "HC.EmailLog.id"
        },
        {
          "name": "Email",
          "type": "NVARCHAR(250)",
          "nullable": false,
          "description": ""
        },
        {
          "name": "FirstName",
          "type": "NVARCHAR(250)",
          "nullable": false,
          "description": "First name, else hash name"
        },
        {
          "name": "Subject",
          "type": "NVARCHAR(250)",
          "nullable": false,
          "description": ""
        },
        {
          "name": "IsIos",
          "type": "SMALLINT",
          "nullable": false,
          "description": "Has an iPhone on record"
        },
        {
          "name": "IsAndroid",
          "type": "SMALLINT",
          "nullable": false,
          "description": "Has an Android phone on record"
        }
      ]
    }
  ],
