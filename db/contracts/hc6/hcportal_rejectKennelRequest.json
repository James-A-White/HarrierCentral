    {
      "name": "deviceId",
      "type": "UNIQUEIDENTIFIER",
      "nullable": true,
      "mapsToColumn": null,
      "description": "Portal device auth (HC.Device.id)."
    },
    {
      "name": "accessToken",
      "type": "NVARCHAR(1000)",
      "nullable": true,
      "mapsToColumn": null,
      "description": "Portal token; standard param string (device secret)."
    },
    {
      "name": "kennelImportIds",
      "type": "NVARCHAR(MAX)",
      "nullable": false,
      "mapsToColumn": "OfficeForms_KennelImport.KennelImportId",
      "description": "'|'-delimited ids; bad ids ignored"
    },
    {
      "name": "newStatus",
      "type": "SMALLINT",
      "nullable": false,
      "mapsToColumn": "OfficeForms_KennelImport.RequestStatus",
      "description": "1, 3, 4 or 5"
    },
    {
      "name": "reviewNote",
      "type": "NVARCHAR(MAX)",
      "nullable": true,
      "mapsToColumn": "OfficeForms_KennelImport.ReviewNote",
      "description": "≤1000; replaces the note when given"
    }
  ],
  "rowsets": [
