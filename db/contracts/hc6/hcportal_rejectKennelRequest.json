{
  "schema": "HC6",
  "name": "hcportal_rejectKennelRequest",
  "version": "1.0.0",
  "description": "Closes open kennel requests as rejected (3), spam (4) or duplicate (5), or reopens one (1). Several ids at once, '|'-delimited. Never touches an approved request. Requires HC.PlatformAdmin with CanEditKennel = 1 (E12.F1).",
