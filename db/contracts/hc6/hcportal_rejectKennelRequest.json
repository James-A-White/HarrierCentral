          "description": ""
        },
        {
          "name": "UpdatedCount",
          "type": "INT",
          "nullable": false,
          "description": ""
        }
      ]
    }
  ],
  "sideEffects": [
    "UPDATE EXT.OfficeForms_KennelImport RequestStatus, ReviewNote, ReviewedBy/At, removed (0 on reopen, else 1), ConfirmCode cleared"
  ],
