      "columns": [
        {
          "name": "success",
          "type": "INT",
          "nullable": false,
          "description": "1 ok"
        },
        {
          "name": "errorMessage",
          "type": "NVARCHAR(MAX)",
          "nullable": true,
          "description": "NULL on success"
        }
      ]
    },
    {
      "index": 1,
