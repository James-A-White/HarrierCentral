      "nullable": false,
      "mapsToColumn": null,
      "description": "Registered device"
    },
    {
      "name": "accessToken",
      "type": "NVARCHAR(1000)",
      "nullable": false,
      "mapsToColumn": null,
      "description": "Short-lived token (standard, device secret)"
    },
    {
      "name": "query",
      "type": "NVARCHAR(MAX)",
      "nullable": false,
      "mapsToColumn": null,
      "description": "what was typed; LIKE wildcards are literal"
    }
  ],
  "rowsets": [
    {
      "index": 0,
      "ref": "StandardErrorResult",
      "description": "14300 refused: too short/long or rate limit (2), message is user-facing; 14301 unhandled (5)"
