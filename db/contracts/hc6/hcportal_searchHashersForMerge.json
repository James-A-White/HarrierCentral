{
  "schema": "HC6",
  "name": "hcportal_searchHashersForMerge",
  "version": "1.0.0",
  "description": "Merge accounts search (E12.F6.S3): live accounts whose hash name matches a term (whole, case- and space-insensitive), or whose email / hasher id / PublicHasherId is a term. Up to 20 terms, 200 rows. Requires HC.PlatformAdmin.CanEditKennel.",
  "parameters": [
    {
      "name": "deviceId",
      "type": "UNIQUEIDENTIFIER",
      "nullable": true,
      "mapsToColumn": null,
      "description": "Portal device auth."
    },
    {
      "name": "accessToken",
      "type": "NVARCHAR(1000)",
      "nullable": true,
      "mapsToColumn": null,
      "description": "Portal token."
    },
    {
      "name": "searchTerms",
      "type": "NVARCHAR(MAX)",
      "nullable": false,
      "mapsToColumn": "Hasher.HashName",
      "description": "'|'-delimited hash names / emails / ids (the portal converts the admin's commas)."
    }
  ],
  "rowsets": [
