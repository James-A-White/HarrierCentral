<?xml version="1.0" encoding="utf-8"?>
<!--
  hcwebapi.azurewebsites.net — redirect only (2026-10-14).

  The kennels' Data API links (portal kennel editor > Developer > Data APIs)
  pointed at this host until the site was deleted in the August 2026 cost
  clean-up; kennel websites and WordPress pages that pasted them stopped
  working, and the name was free for anyone to take. It was reclaimed as an
  empty web app on the free F1 plan "Harrier" (RG HarrierCentral, beside
  HCWeb) that serves nothing but this rule:

      https://hcwebapi.azurewebsites.net/<path>?<query>
   →  302  https://harriercentralpublicapi.azurewebsites.net/api/<path>?<query>

  The API answers CORS * so a browser's fetch follows the redirect; server
  callers (PHP, WordPress) follow it by default. The kennel's ExtApiKey
  travels in the query string as before. 302, not 301, so the target can
  change without browsers having cached the old one.

  Deploy: see api/legacy-hcwebapi/README.md (an XML comment cannot hold
  a double hyphen, so the command lives there).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="To harriercentralpublicapi" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Redirect" url="https://harriercentralpublicapi.azurewebsites.net/api/{R:1}" appendQueryString="true" redirectType="Found" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
