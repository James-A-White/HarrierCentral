{
  "permissions": {
    "allow": [
      "Bash(flutter analyze *)",
      "Bash(dart analyze *)"
    ],
    "ask": [
      "Bash(./tools/deploy_hc6.sh *)",
      "Bash(tools/deploy_hc6.sh *)",
      "Bash(bash tools/deploy_hc6.sh *)",
      "Bash(func azure functionapp publish *)",
      "Bash(az webapp deploy *)",
      "Bash(git push * master*)",
      "Bash(git push *:master*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dart-scans.sh"
          }
        ]
      }
    ]
  }
}
